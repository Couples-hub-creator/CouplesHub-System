# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_GUILD_ID=your_guild_id_for_dev_commands

# Lavalink Configuration
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/discord_bot

# Dashboard Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# YouTube Cookie (for youtube-source plugin)
# Generate at: https://console.cloud.google.com/apis/credentials
# Or use cookies from browser (not recommended for production)
YOUTUBE_COOKIE=

# OpenAI API (optional, for AI chat command)
OPENAI_API_KEY=

# Node Environment
NODE_ENV=development
