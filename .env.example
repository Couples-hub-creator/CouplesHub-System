# ─────────────────────────────────────────────────────────────────────────────
# Couples Hub — environment template
# Copy to .env (bot + docker) and packages/dashboard/.env.local (Next.js dev).
# Nothing here is a real secret. Generate your own values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site ──────────────────────────────────────────────────────────────
# Used for canonical URLs, OG images, sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional: leave blank to use the built-in /api/discord/invite redirect.
NEXT_PUBLIC_INVITE_URL=
NEXT_PUBLIC_SUPPORT_URL=

# ── Discord application (Developer Portal) ───────────────────────────────────
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
NEXT_PUBLIC_DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret
# Optional: register slash commands only in this server during development.
DISCORD_GUILD_ID=

# ── NextAuth ─────────────────────────────────────────────────────────────────
# openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_32_byte_secret
NEXTAUTH_URL=http://localhost:3001

# ── Database (PostgreSQL, shared by bot and dashboard) ───────────────────────
# Any PostgreSQL works. On Neon, DATABASE_URL is the pooled string and
# DATABASE_URL_UNPOOLED is the direct string used by Prisma CLI/migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_bot?schema=public
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/discord_bot?schema=public

# ── Lavalink ─────────────────────────────────────────────────────────────────
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace_with_a_strong_lavalink_password

# ── Bot control API (server-to-server, optional) ─────────────────────────────
# When both are set, the dashboard can read and control the live player.
# When unset, the dashboard shows an honest "not connected" state.
# The bot must verify X-CouplesHub-Signature — see docs/bot-integration.md.
BOT_API_URL=
BOT_API_SECRET=
BOT_API_HOST=127.0.0.1
BOT_API_PORT=4000

# ── Cache and scheduler (optional) ─────────────────────────────────────────────
# Redis makes config, cooldowns and AI memory shared across restarts and
# replicas. Without it the bot uses an in-process cache.
REDIS_URL=
SCHEDULER_POLL_MS=5000
CARD_WORKERS=2
TZ=UTC

# ── AI chat (optional) ─────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works. Leave the key blank to keep AI chat
# visibly unconfigured instead of failing silently.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Pusher (optional — polling fallback is built in) ─────────────────────────
# All six values are required for real-time updates to activate.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ── Billing (optional) ───────────────────────────────────────────────────────
# The premium page reports billing as unavailable until one of these is set.
STRIPE_SECRET_KEY=
LEMON_SQUEEZY_API_KEY=

# ── Demo mode ────────────────────────────────────────────────────────────────
# Reserved for a future sample-data layer. This build ships no fabricated data:
# every screen uses real database rows or an explicit empty state.
NEXT_PUBLIC_DEMO_MODE=false
