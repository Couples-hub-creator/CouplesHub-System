# Discord Developer Portal → General Information / OAuth2
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
NEXT_PUBLIC_DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret
# Optional: registers commands only in this server during development
DISCORD_GUILD_ID=

# Local services; Docker Compose overrides service hostnames inside containers
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotchange_this_local_password
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_bot?schema=public

# Local NextAuth
NEXTAUTH_SECRET=generate_a_random_secret
NEXTAUTH_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3001

# Pusher (optional, for real-time features)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
