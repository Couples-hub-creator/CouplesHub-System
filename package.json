{
  "name": "discord-bot-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:bot\" \"npm run dev:dashboard\"",
    "dev:bot": "npm run dev --workspace=packages/bot",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "cd packages/bot && npx prisma generate",
    "db:migrate": "cd packages/bot && npx prisma migrate dev",
    "db:push": "cd packages/bot && npx prisma db push",
    "db:studio": "cd packages/bot && npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  }
}
