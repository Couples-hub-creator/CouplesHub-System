generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Guild {
  id                String   @id @default(cuid())
  guildId           String   @unique
  prefix            String   @default("!")
  language          String   @default("en")
  timezone          String   @default("UTC")
  musicEnabled      Boolean  @default(true)
  moderationEnabled Boolean  @default(true)
  autoModEnabled    Boolean  @default(true)
  welcomeEnabled    Boolean  @default(true)
  levelingEnabled   Boolean  @default(true)
  economyEnabled    Boolean  @default(true)
  ticketsEnabled    Boolean  @default(true)
  rolesEnabled      Boolean  @default(true)
  communityEnabled  Boolean  @default(true)
  loggingEnabled    Boolean  @default(true)
  extrasEnabled     Boolean  @default(true)
  funEnabled        Boolean  @default(true)
  utilityEnabled    Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  musicSettings     MusicSettings?
  moderationSettings ModerationSettings?
  welcomeSettings   WelcomeSettings?
  levelingSettings  LevelingSettings?
  economySettings   EconomySettings?
  ticketSettings    TicketSettings?
  roleSettings      RoleSettings?
  communitySettings CommunitySettings?
  loggingSettings   LoggingSettings?
  extraSettings     ExtraSettings?
  funSettings       FunSettings?
  utilitySettings   UtilitySettings?

  users             User[]
  infractions       Infraction[]
  tickets           Ticket[]
  giveaways         Giveaway[]
  polls             Poll[]
  suggestions       Suggestion[]
  reminders         Reminder[]
  starboardMessages StarboardMessage[]
  birthdaySettings  BirthdaySettings[]
  customCommands    CustomCommand[]
  tempVoiceChannels TempVoiceChannel[]
  reactionRoles     ReactionRole[]
  buttonRoles       ButtonRole[]
  selectMenuRoles   SelectMenuRole[]
  logs              LogEntry[]

  aiChatSettings    AiChatSettings?
  scheduleTasks     ScheduleTask[]
  radioStations     RadioStation[]
  playlists         SavedPlaylist[]
  premium           PremiumSubscription?
  dashboardAudits   DashboardAudit[]
  moduleConfigs     ModuleConfig[]
  configAudits      ConfigAudit[]
  commandPermissions CommandPermission[]
  verificationSessions VerificationSession[]
  strikes           Strike[]
  inviteRecords     InviteRecord[]
  xpEvents          XpEvent[]
  birthdays         Birthday[]
  afkStatuses       AfkStatus[]
  securitySnapshots SecuritySnapshot[]
  backups           Backup[]
}

model User {
  id            String   @id @default(cuid())
  userId        String
  guildId       String
  xp            Int      @default(0)
  level         Int      @default(0)
  balance       Int      @default(0)
  dailyCooldown DateTime?
  workCooldown  DateTime?
  inventory     Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild         Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  infractions   Infraction[]
  tickets       Ticket[]
  giveaways     GiveawayParticipant[]
  pollVotes     PollVote[]
  reminders     Reminder[]

  @@unique([userId, guildId])
}

model MusicSettings {
  id                String   @id @default(cuid())
  guildId           String   @unique
  defaultVolume     Int      @default(100)
  autoPlay          Boolean  @default(false)
  twentyFourSeven   Boolean  @default(false)
  twentyFourSevenChannel String?
  djRole            String?
  djOnly            Boolean  @default(false)
  voteSkipRequired  Int      @default(3)
  voteSkipEnabled   Boolean  @default(true)
  leaveOnEmpty      Boolean  @default(true)
  leaveOnEmptyDelay Int      @default(300000)
  previousTrack     Boolean  @default(true)
  repeat            Boolean  @default(false)
  shuffle           Boolean  @default(false)
  defaultSearch     String   @default("scsearch")
  guild             Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model ModerationSettings {
  id                  String   @id @default(cuid())
  guildId             String   @unique
  modLogChannel       String?
  autoModEnabled      Boolean  @default(true)
  maxWarnsBeforeBan   Int      @default(5)
  banDeleteDays       Int      @default(1)
  defaultMuteDuration Int      @default(600000)
  guild               Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model AutoModRule {
  id              String   @id @default(cuid())
  guildId         String
  ruleType        String   // anti-spam, anti-link, bad-word, anti-mention, raid-protection
  enabled         Boolean  @default(true)
  punishment      String   // warn, mute, kick, ban
  threshold       Int      @default(5)
  timeWindow      Int      @default(60000)
  whitelistChannels String[] @default([])
  whitelistRoles  String[] @default([])
  badWords        String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Infraction {
  id          String   @id @default(cuid())
  userId      String
  guildId     String
  moderatorId String
  type        String   // warn, mute, kick, ban
  reason      String?
  duration    Int?
  active      Boolean  @default(true)
  caseNumber  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime?
  evidence    String?
  notes       String?
  deletedAt   DateTime?
  metadata    Json     @default("{}")

  user        User     @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)
  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, userId])
  @@index([guildId, type, active])
}

model WelcomeSettings {
  id              String   @id @default(cuid())
  guildId         String   @unique
  welcomeChannel  String?
  welcomeMessage  String?
  welcomeImage    Boolean  @default(false)
  leaveChannel    String?
  leaveMessage    String?
  autoRoles       String[] @default([])
  embedColor      String?
  guild           Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model LevelingSettings {
  id                 String   @id @default(cuid())
  guildId            String   @unique
  xpPerMessage       Int      @default(15)
  xpPerVoiceMinute   Int      @default(5)
  messageCooldown    Int      @default(60000)
  voiceCooldown      Int      @default(60000)
  levelUpMessage     Boolean  @default(true)
  levelUpTemplate    String?
  roleRewards        Json     @default("[]")
  ignoredChannels    String[] @default([])
  ignoredRoles       String[] @default([])
  guild              Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model EconomySettings {
  id                   String   @id @default(cuid())
  guildId              String   @unique
  dailyAmount          Int      @default(100)
  workMinAmount        Int      @default(50)
  workMaxAmount        Int      @default(200)
  cooldownDaily        Int      @default(86400000)
  cooldownWork         Int      @default(300000)
  guild                Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model TicketSettings {
  id                 String   @id @default(cuid())
  guildId            String   @unique
  ticketChannel      String?
  ticketCategory     String?
  transcriptChannel  String?
  staffRoles         String[] @default([])
  guild              Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model Ticket {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  channelId   String
  category    String
  status      String   @default("open")
  claimedBy   String?
  createdAt   DateTime @default(now())
  closedAt    DateTime?

  user        User     @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)
  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model RoleSettings {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model CommunitySettings {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model Giveaway {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String
  prize       String
  winners     Int
  endTime     DateTime
  hostedBy    String
  requirements Json? @default("{}")
  ended       Boolean  @default(false)
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  participants GiveawayParticipant[]
}

model GiveawayParticipant {
  id          String   @id @default(cuid())
  giveawayId  String
  userId      String
  guildId     String
  enteredAt   DateTime @default(now())

  giveaway    Giveaway  @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)

  @@unique([giveawayId, userId])
}

model Poll {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String
  question    String
  options     Json
  endTime     DateTime?
  ended       Boolean  @default(false)
  multiSelect Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  votes       PollVote[]
}

model PollVote {
  id       String   @id @default(cuid())
  pollId   String
  userId   String
  guildId  String
  option   Int
  votedAt  DateTime @default(now())

  poll     Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)

  @@unique([pollId, userId, option])
}

model Suggestion {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  channelId   String?
  messageId   String?
  content     String
  status      String   @default("pending")
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  guildId     String
  channelId   String
  message     String
  remindAt    DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)
  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model LoggingSettings {
  id              String   @id @default(cuid())
  guildId         String   @unique
  messageLogs     String?
  memberLogs      String?
  moderationLogs  String?
  voiceLogs       String?
  roleLogs        String?
  channelLogs     String?
  guild           Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model LogEntry {
  id          String   @id @default(cuid())
  guildId     String
  type        String
  action      String
  userId      String?
  targetId    String?
  content     Json
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model ExtraSettings {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model StarboardMessage {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String?
  authorId    String?
  originalId  String
  starboardId String
  starCount   Int      @default(0)
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, originalId])
}

model BirthdaySettings {
  id          String   @id @default(cuid())
  guildId     String   @unique
  channel     String?
  message     String?
  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model CustomCommand {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  response    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, name])
}

model TempVoiceChannel {
  id          String   @id @default(cuid())
  guildId     String
  ownerId     String
  channelId   String   @unique
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model ReactionRole {
  id          String   @id @default(cuid())
  guildId     String
  messageId   String
  channelId   String
  emoji       String
  roleId      String
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model ButtonRole {
  id          String   @id @default(cuid())
  guildId     String
  messageId   String
  channelId   String
  label       String
  style       String
  roleId      String
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model SelectMenuRole {
  id          String   @id @default(cuid())
  guildId     String
  messageId   String
  channelId   String
  label       String
  roleId      String
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model FunSettings {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model UtilitySettings {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

// -------------------------------------------------------------
// Dashboard-driven modules
// -------------------------------------------------------------

model AiChatSettings {
  id              String   @id @default(cuid())
  guildId         String   @unique
  enabled         Boolean  @default(false)
  channels        String[] @default([])
  triggerMode     String   @default("mention") // mention | always
  personality     String   @default("balanced")
  systemPrompt    String?
  creativity      Int      @default(60) // 0-100
  replyLength     String   @default("medium") // short | medium | long
  memoryEnabled   Boolean  @default(false)
  memoryDepth     Int      @default(10)
  rateLimitPerHour Int     @default(5)
  blockedTopics   String[] @default([])
  monthlyQuota    Int      @default(1000)
  usedThisPeriod  Int      @default(0)
  periodStart     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild           Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model ScheduleTask {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  kind        String   // command | message | event
  payload     String
  channelId   String?
  recurrence  String   @default("once") // once | daily | weekly | monthly | cron
  cron        String?
  runAt       DateTime?
  timezone    String   @default("UTC")
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  runs        ScheduleRun[]

  @@index([guildId, enabled])
}

model ScheduleRun {
  id        String   @id @default(cuid())
  taskId    String
  status    String   // success | failed | skipped
  detail    String?
  ranAt     DateTime @default(now())

  task      ScheduleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, ranAt])
}

model RadioStation {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  genre     String   @default("custom")
  streamUrl String
  logoUrl   String?
  favorite  Boolean  @default(false)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

model SavedPlaylist {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  createdBy String
  tracks    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

model PremiumSubscription {
  id           String   @id @default(cuid())
  guildId      String   @unique
  plan         String   @default("premium")
  status       String   @default("inactive") // active | inactive | past_due | canceled
  provider     String?
  externalId   String?
  currentStart DateTime?
  currentEnd   DateTime?
  cancelAtEnd  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild        Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model DashboardAudit {
  id           String   @id @default(cuid())
  guildId      String
  actorId      String
  actorName    String?
  action       String
  target       String?
  detail       Json     @default("{}")
  createdAt    DateTime @default(now())

  guild        Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, createdAt])
}

// -------------------------------------------------------------
// Platform foundation
// -------------------------------------------------------------

model ModuleConfig {
  id          String   @id @default(cuid())
  guildId     String
  moduleId    String
  version     Int      @default(1)
  data        Json     @default("{}")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, moduleId])
  @@index([guildId])
}

model ConfigAudit {
  id          String   @id @default(cuid())
  guildId     String
  moduleId    String
  actorId     String?
  actorName   String?
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, moduleId, createdAt])
}

model SystemJob {
  id             String    @id @default(cuid())
  type           String
  guildId        String?
  payload        Json      @default("{}")
  runAt          DateTime
  status         String    @default("pending") // pending | running | done | failed | cancelled
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lockedAt       DateTime?
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
  @@index([guildId, status])
}

model CommandPermission {
  id               String   @id @default(cuid())
  guildId          String
  commandName      String
  allowRoleIds     String[] @default([])
  denyRoleIds      String[] @default([])
  allowChannelIds  String[] @default([])
  denyChannelIds   String[] @default([])
  updatedAt        DateTime @updatedAt

  guild            Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, commandName])
}

model VerificationSession {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  token       String
  challenge   String?
  answerHash  String?
  attempts    Int      @default(0)
  verifiedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, expiresAt])
}

model Strike {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  rule        String
  weight      Int      @default(1)
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, userId, createdAt])
  @@index([guildId, expiresAt])
}

model InviteRecord {
  id          String   @id @default(cuid())
  guildId     String
  inviteCode  String
  inviterId   String
  inviteeId   String
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  fake        Boolean  @default(false)
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, inviterId])
  @@index([guildId, inviteeId])
}

model XpEvent {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  amount      Int
  source      String   // text | voice | bonus | admin
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, userId, createdAt])
  @@index([guildId, createdAt])
}

model Birthday {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  month       Int
  day         Int
  year        Int?
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, month, day])
}

model AfkStatus {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  message     String?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
}

model SecuritySnapshot {
  id          String   @id @default(cuid())
  guildId     String
  kind        String
  data        Json     @default("{}")
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, kind, createdAt])
}

model Backup {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  data        Json     @default("{}")
  createdBy   String?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, createdAt])
}

model PlatformState {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
}
