# Couples Hub dashboard — local development
# Next.js loads this file from packages/dashboard. Values mirror the root .env.example.

NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_INVITE_URL=
NEXT_PUBLIC_SUPPORT_URL=

DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
NEXT_PUBLIC_DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret

NEXTAUTH_SECRET=replace_with_a_random_32_byte_secret
NEXTAUTH_URL=http://localhost:3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_bot?schema=public

# Optional server-to-server player control
BOT_API_URL=
BOT_API_SECRET=

# Optional real-time (all six required)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional billing
STRIPE_SECRET_KEY=
LEMON_SQUEEZY_API_KEY=

NEXT_PUBLIC_DEMO_MODE=false
